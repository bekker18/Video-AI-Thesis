FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

COPY requirements-sampling.txt requirements-segmentation.txt ./
RUN pip install --no-cache-dir -r requirements-sampling.txt -r requirements-segmentation.txt

COPY . .

ENTRYPOINT ["python", "-m", "src.segmentation"]
