# syntax=docker/dockerfile:1
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN --mount=type=cache,target=/root/.cache/pip \
    for i in 1 2 3 4 5 6 7 8; do \
    pip install --timeout 60 torch torchvision && exit 0; \
    echo "torch install attempt $i stalled, retrying from cache"; \
    done; exit 1

COPY requirements-sampling.txt requirements-association.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
    for i in 1 2 3 4 5; do \
    pip install --timeout 60 \
    -r requirements-sampling.txt -r requirements-association.txt && exit 0; \
    echo "requirements install attempt $i stalled, retrying from cache"; \
    done; exit 1

COPY . .

ENTRYPOINT ["python", "-m", "src.association"]
